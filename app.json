{
  "expo": {
    "name": "Preflight",
    "slug": "preflight",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "preflight",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.luisaugusto.preflight",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      "expo-asset",
      "expo-status-bar"
    ],
    "extra": {
      "sanityProjectId": "4qoowg94",
      "sanityDataset": "production",
      "sanityApiVersion": "2026-07-12",
      "contentManifestUrl": "https://4qoowg94.apicdn.sanity.io/v2026-07-12/data/query/releases?query=*%5B_type%20%3D%3D%20%22curriculumReleasePointer%22%20%26%26%20_id%20%3D%3D%20%22curriculumReleasePointer.current%22%5D%5B0%5D%7BschemaVersion%2CcatalogId%2CmoduleIds%2CcontentVersion%2CminimumAppVersion%2CbundleUrl%2Cchecksum%2Calgorithm%2CbyteLength%2CcreatedAt%7D",
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "54d0e795-a938-4800-b7a6-81dc4f0f6fb3"
      }
    }
  }
}
